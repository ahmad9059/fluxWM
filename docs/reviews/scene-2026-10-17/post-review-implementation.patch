+        evidence["workspace_mode"] = json!("canvas");
+        let before = control.call("windows.list", json!({}), deadline)?;
+        let windows = before["windows"].as_array().ok_or("missing root list")?;
+        if windows.len() != 1 {
+            return Err("popupclip requires one isolated root".into());
