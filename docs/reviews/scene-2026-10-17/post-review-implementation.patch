+#!/usr/bin/env python3
+"""Real pointer/grab regression on an authenticated, owned private Xvfb only."""
+from __future__ import annotations
+import argparse
+import ctypes as C
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import secrets
+import socket
+import struct
+import subprocess
+import sys
+import time
+import urllib.request
+import uuid
